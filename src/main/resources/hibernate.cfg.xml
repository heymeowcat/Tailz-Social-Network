<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
    "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <property name="hibernate.dialect">org.hibernate.dialect.MySQL5Dialect</property>
        <property name="hibernate.connection.driver_class">com.mysql.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/tailz?useSSL=false</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password"></property>
        <property name="hibernate.hbm2ddl.auto">update</property>
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.connection.pool_size">10</property>
        <property name="hibernate.current_session_context_class">thread</property>
        <property name="hibernate.jdbc.batch_size">20</property>

        <mapping class="com.heymeowcat.tailznet.entities.User"/>
        <mapping class="com.heymeowcat.tailznet.entities.UserLogin"/>
        <mapping class="com.heymeowcat.tailznet.entities.UserProfilePic"/>
        <mapping class="com.heymeowcat.tailznet.entities.Post"/>
        <mapping class="com.heymeowcat.tailznet.entities.PostComment"/>
        <mapping class="com.heymeowcat.tailznet.entities.Chat"/>
        <mapping class="com.heymeowcat.tailznet.entities.GroupEntity"/>
        <mapping class="com.heymeowcat.tailznet.entities.GroupMembers"/>
        <mapping class="com.heymeowcat.tailznet.entities.GroupChat"/>
        <mapping class="com.heymeowcat.tailznet.entities.Follow"/>
        <mapping class="com.heymeowcat.tailznet.entities.Notification"/>
        <mapping class="com.heymeowcat.tailznet.entities.AppTheme"/>
        <mapping class="com.heymeowcat.tailznet.entities.Ads"/>
        <mapping class="com.heymeowcat.tailznet.entities.AdTiming"/>
        <mapping class="com.heymeowcat.tailznet.entities.UserBookmark"/>
        <mapping class="com.heymeowcat.tailznet.entities.UserPrivacy"/>
        <mapping class="com.heymeowcat.tailznet.entities.PostRank"/>
        <mapping class="com.heymeowcat.tailznet.entities.LoginSession"/>
        <mapping class="com.heymeowcat.tailznet.entities.AppLayout"/>
    </session-factory>
</hibernate-configuration>
